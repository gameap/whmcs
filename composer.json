{
    "name": "gameap/whmcs-module",
    "description": "GameAP provisioning module for WHMCS",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload-dev": {
        "psr-4": {
            "WHMCS\\Module\\Server\\Gameap\\": "modules/servers/gameap/lib/",
            "GameAP\\Whmcs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
